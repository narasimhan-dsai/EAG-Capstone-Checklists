# checklist_agent contains no provider keys. Provider credentials belong to the gateway.
GLC_BASE_URL=http://127.0.0.1:8111
CHECKLIST_GATEWAY_PROVIDER=gemini
# Override the gateway's own default model per-call, without editing the
# shared gateway instance. Needed as of 2026-09-29: the shared instance's
# pricing.yaml still defaults gemini_1/gemini_2 to gemini-2.5-flash, which
# Google has deprecated (confirmed live: 404, replacement named in the
# error body). Leave unset to use whatever the gateway defaults to.
CHECKLIST_GATEWAY_MODEL=gemini-3.8-flash
# Providers to fall back to, in order, when the primary returns 429/502/503.
# The model name is not sent to a fallback, so set each fallback provider's
# model in the gateway's own .env (for example NVIDIA_MODEL, GEMINI_MODEL).
# CHECKLIST_GATEWAY_FALLBACK_PROVIDERS=groq,gemini
# Optional routing for the final answer only (planning keeps the settings
# above). Use the strongest model here: it is one call per query.
# CHECKLIST_ANSWER_PROVIDER=groq
# CHECKLIST_ANSWER_MODEL=openai/gpt-oss-120b
CHECKLIST_PORT=8113
CHECKLIST_A2A_GRPC_PORT=8114
CHECKLIST_CHUNK_MODEL=phi4:latest
CHECKLIST_LIVE_SEMANTIC_CHUNKING=1
CHECKLIST_MAX_WORKERS=4

# Channel bridge token for the LLM gateway's channel adapters. Unused by the Seat 23 agent.
CHECKLIST_CHANNEL_BRIDGE_TOKEN=replace-with-a-long-random-local-token
CHECKLIST_CHANNEL_TENANT=local
# Explicit comma-separated authority for channel-originated side effects.
# Empty is read-only. Enable only what paired owners should be allowed to ask for.
# The complete shipped set is shown so the policy is visible, not hidden in code.
CHECKLIST_CHANNEL_ALLOWED_SIDE_EFFECTS=remember_explicit_fact,write_file,copy_file,index_file,create_calendar_events,send_channel_message,launch_job,request_approval

# Set this to an absolute path before using local file skills.
CHECKLIST_SANDBOX_ROOT=/absolute/path/to/S17Code/sandbox

# Economics config directory. Defaults to ./config beside the package.
# CHECKLIST_CONFIG_DIR=/absolute/path/to/S17Code/config

# Trace export. Unset means the span tree is still built and asserted in memory
# and nothing goes over the wire, so tests and CI need no collector.
# CHECKLIST_OTEL_EXPORTER_ENDPOINT=http://127.0.0.1:4318/v1/traces
# CHECKLIST_OTEL_SERVICE_NAME=checklist_agent
# Prompts and completions are PII. Content capture stays OFF unless set to 1.
CHECKLIST_OTEL_CAPTURE_CONTENT=0

# --- Control plane. Every write path FAILS CLOSED without these. ---
# Subscriptions, event ingest, run creation and resume. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CHECKLIST_CONTROL_TOKEN=replace-with-a-long-random-local-token
# Job-completion callbacks only. Deliberately a different token: a remote job
# service may finish work it was given without being able to write authority.
CHECKLIST_COMPLETION_TOKEN=replace-with-a-different-long-random-token

# --- Bounds on unattended operation ---
# Identities this agent uses when it acts. An event carrying one of these as its
# actor is refused at intake, so the agent cannot answer its own reply.
CHECKLIST_SELF_ACTORS=checklist_agent
# Per-source arrival limit. Anyone who can create an event can schedule this
# agent, so intake is bounded before anything is persisted or billed.
CHECKLIST_SOURCE_EVENTS_PER_MINUTE=120
# Event bodies retained. Identities are kept beyond this: forgetting a body
# loses history, forgetting an id repeats work.
CHECKLIST_EVENT_HISTORY_MAX=5000
# How long a schedule lease is held before a later tick may steal it.
CHECKLIST_LEASE_TTL_SECONDS=900

# --- Session 17: the coding surface ---
# The only directory the agent may edit. Coding capabilities are hidden without it.
CHECKLIST_WORKSPACE=/absolute/path/to/the/repo/it/may/edit
# Commands it may run. No shell is ever involved, so these are programs, not lines.
CHECKLIST_ALLOWED_COMMANDS=pytest,python,uv,ruff,git,node,npm
# The judge. These paths are refused before an edit is attempted.
CHECKLIST_PROTECTED_PATHS=tests/**,conftest.py,pytest.ini,pyproject.toml,.github/**
# Stop a verification that keeps failing without converging.
CHECKLIST_MAX_REPEAT_FAILURES=4
# Run every command inside a container instead of on the host.
CHECKLIST_EXEC_CONTAINER=0

# --- Session 17: markdown skills ---
# SKILL.md files, discovered at startup. Unset means the agent behaves exactly
# as it did before skills existed.
CHECKLIST_SKILLS_DIR=/absolute/path/to/S17Code/skills

# --- AgentSwitch: the live checklist data/execution backend (India tenant, Suryodaya) ---
# Login once (POST /api/auth/login) and reuse the bearer token. The interface is MCP
# (POST {base_url}/api/mcp, JSON-RPC 2.0), scoped per seat. A JSON-RPC error still returns
# HTTP 200: check the envelope's "error" field.
AGENTSWITCH_IN_BASE_URL=https://agentswitch.theschoolofai.in
AGENTSWITCH_IN_EMAIL=team23@theschoolofai.in
AGENTSWITCH_IN_PASSWORD=replace-with-the-team-password
# The US tenant (Keystone) is out of scope for this seat.
# AGENTSWITCH_US_BASE_URL=https://class.agentswitch.theschoolofai.in
